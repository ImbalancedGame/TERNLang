// Pattern matching edge cases: non-numeric subjects against range arms, rest
// bindings, and guards that assume a type.
fn classify(value) {
    return match value {
        1 | 2 | 3 => "small",
        4..9 => "digit",
        10..<100 => "two digits",
        "hi" => "greeting",
        nil => "nothing",
        true => "yes",
        [x] => "one:${x}",
        [a, b] => "pair:${a},${b}",
        [first, ...rest] => "first:${first}, rest:${len(rest)}",
        n if type(n) == "int" and n > 100 => "big",
        _ => "other",
    };
}

for probe in [2, 5, 42, "hi", nil, true, 3.5, [7], [1, 2], [1, 2, 3, 4], 500, {"k": 1}] {
    println("${repr(probe)} -> ${classify(probe)}");
}

// Rest binding keeps everything after the fixed prefix.
let values = [10, 20, 30, 40, 50];
match values {
    [head, ...tail] => {
        println(head);
        println(tail);
        println(len(tail));
    },
    _ => println("no match"),
}

// A range arm only matches numbers, so mixed arms keep working.
fn describe(value) {
    return match value {
        0..<10 => "low",
        10..<20 => "mid",
        _ => "high or not a number",
    };
}
for probe in [3, 15, 30, "text", nil, 3.5] { println(describe(probe)); }

// Guards see the bound name.
fn rated(value) {
    return match value {
        n if n >= 90 => "A",
        n if n >= 80 => "B",
        _ => "C",
    };
}
println(rated(95), rated(85), rated(10));

// Map patterns are subset tests: the named keys must be present and match,
// any other keys are ignored.
fn route(event) {
    return match event {
        {"kind": "click", "x": x, "y": y} => "click ${x},${y}",
        {"kind": "key", "code": code} => "key ${code}",
        {"kind": kind} => "kind ${kind}",
        {} => "untyped map",
        _ => "not a map",
    };
}
for probe in [{"kind": "click", "x": 1, "y": 2}, {"kind": "key", "code": 27},
              {"kind": "key", "code": 27, "shift": true}, {"kind": "scroll"}, {}, [1]] {
    println(route(probe));
}

// `{name}` is shorthand for `{name: name}`; a present-but-nil key still counts.
fn pair(value) { return match value { {left, right} => left + right, _ => -1 }; }
println(pair({"left": 1, "right": 2}), pair({"left": 1}), pair({"left": 0, "right": 0}));
fn nilKey(value) {
    return match value { {"a": nil} => "a is nil", {"a": _} => "a is set", _ => "no a" };
}
println(nilKey({"a": nil}), nilKey({"a": 1}), nilKey({}));

// Nested structural patterns bind all the way down.
fn deep(value) {
    return match value {
        [[a, b], [c, d]] => "grid ${a + b + c + d}",
        {"rows": [[x, y], ...rest]} => "rows ${x},${y} +${len(rest)}",
        [x, [y, z]] => "triple ${x + y + z}",
        _ => "?",
    };
}
println(deep([[1, 2], [3, 4]]), deep({"rows": [[5, 6], [7, 8], [9, 10]]}), deep([1, [2, 3]]));

// Negative range arms.
fn sign(n) {
    return match n {
        -9..-1 => "negative digit",
        0..9 => "digit",
        -100..-10 => "big negative",
        _ => "out of range",
    };
}
println(sign(-5), sign(5), sign(-50), sign(-500), sign(0), sign(-1.5));
