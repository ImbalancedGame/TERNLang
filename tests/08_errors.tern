try {
    throw "boom";
} catch (e) {
    println("caught: " + e);
}

try {
    let x = [1][5];
} catch (e) {
    println("index: " + e);
}


try {
    nil.foo();
} catch (e) {
    println("member: " + e);
}

fn mayFail(n) {
    if (n < 0) { throw "negative input"; }
    return n;
}
try {
    mayFail(-1);
} catch (e) {
    println("fn: " + e);
}

try { throw "a"; } catch (e) { println("inner " + e); } finally { println("finally runs"); }

try {
    try {
        throw "deep";
    } finally {
        println("cleanup");
    }
} catch (e) {
    println("outer caught: " + e);
}

let count = 0;
fn risky() {
    try {
        count += 1;
        if count < 3 { throw "retry"; }
        return "ok";
    } catch (e) {
        return risky();
    }
}
println(risky());

try {
    assert(1 == 2, "math is broken");
} catch (e) {
    println("assert: " + e);
}

// Runtime errors are catchable strings, and argument-count mistakes name the
// function (C# and native back ends agree on all of these).
fn kind(block) {
    try {
        block();
        return "no error";
    } catch (e) {
        return str(e);
    }
}
println(kind(fn() { len(); }));
println(kind(fn() { len([1], 2); }));
println(kind(fn() { str(); }));
println(kind(fn() { type(1, 2); }));
println(kind(fn() { input("a", "b"); }));
println(kind(fn() { assert(true, "m", 3); }));
println(kind(fn() { range("x"); }));
println(kind(fn() { "ab".repeat("x"); }));
println(kind(fn() { [1].insert("x", 2); }));
println(kind(fn() { [1, 2].take(1.7); }));
println(kind(fn() { len(1); }));
println(kind(fn() { "a" - 1; }));
println(kind(fn() { 1 & "x"; }));
println(kind(fn() { ~"x"; }));
println(kind(fn() { [1]["k"]; }));
println(kind(fn() { keys([1]); }));

// Methods count the receiver as argument 1, so the numbers differ from globals.
println(kind(fn() { let l = [1]; l.push(); }));
println(kind(fn() { "ab".repeat(1, 2); }));
println(kind(fn() { "ab".upper(1); }));
println(kind(fn() { "abc".slice(0, 1, 2); }));
println(kind(fn() { let m = {"a": 1}; m.get(); }));
println(kind(fn() { [2, 1].sort(1); }));
println(kind(fn() { max(); }));

// Namespace members check their counts too: the compiled backend used to read
// missing arguments as nil, and a zero-argument call could crash it outright.
println(kind(fn() { math.floor(); }));
println(kind(fn() { math.floor(1, 2); }));
println(kind(fn() { math.round(1, 2, 3); }));
println(kind(fn() { math.clamp(1, 2); }));
println(kind(fn() { math.gcd(1); }));
println(kind(fn() { math.min(); }));
println(kind(fn() { fs.read(); }));
println(kind(fn() { fs.write("x"); }));
println(kind(fn() { json.parse(); }));
println(kind(fn() { json.stringify(); }));
println(kind(fn() { os.env(); }));
println(kind(fn() { time.millis(1); }));
println(kind(fn() { random.int(1, 2, 3); }));
println(kind(fn() { text.format(); }));
println(kind(fn() { text.trim(); }));
println(kind(fn() { lists.zip(); }));
println(kind(fn() { lists.chunk([1], 2, 3); }));

// A negative index is reported as written, and a bad range key names its type.
println(kind(fn() { let row = [10, 20, 30]; return row[-9]; }));
println(kind(fn() { return "ab"[-9]; }));
println(kind(fn() { let span = 1..5; return span[-9]; }));
println(kind(fn() { let span = 1..5; return span[span]; }));

// The script ends with an uncaught error so the trace report is part of the golden.
error("custom failure");
