println(len("abc"), len([1, 2]), len({"a": 1}), len(0..4));
println(abs(-3), math.abs(-3.5));
println(math.floor(3.7), math.ceil(3.2), math.round(3.5));
println(math.sqrt(16), math.pow(2, 8));
println(math.min(3, 1, 2), math.max(3, 1, 2));
println(math.pi > 3.14);
println(math.clamp(15, 0, 10));
println(int("42"), float("1.5"), int(2.9), int(true));
println(chr(65), ord("A"));
println(str([1, 2]));
println(repr("quoted"));
println(type(1), type(1.5), type("s"), type([]));
println(min(1, 2), max(1, 2));
println(lists.range(3));
println(lists.zip([1, 2], ["a", "b"]));
println(lists.enumerate(["x"]));
println(lists.chunk([1, 2, 3, 4, 5], 2));
println(text.format("{} + {} = {}", 1, 2, 3));
println(text.format("{0} {0}", "twice"));
println(json.stringify([1, {"a": true}], true));
println(os.platform());
println(time.now() > 0);
println(random.int(1, 6) >= 1);
