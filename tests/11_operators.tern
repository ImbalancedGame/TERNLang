// Membership, slicing, and formatting.
println(2 in [1, 2, 3]);
println(9 in [1, 2, 3]);
println("ell" in "hello");
println("z" in "hello");
println("k" in {"k": 1});
println(3 in 0..<5);
println(3 not in 0..<3);

let xs = [10, 20, 30, 40, 50];
println(xs[1..3]);
println(xs[1..<3]);
println(xs[..2]);
println(xs[2..]);
println(xs[..]);
println(xs[-2..]);

let s = "abcdef";
println(s[1..3]);
println(s[..<2]);
println(s[3..]);

println(text.format("{0}-{}", "a", "b"));
println(text.format("{} and {}", "x", "y"));

// for loops over membership-heavy data
let allowed = ["read", "write"];
let granted = [];
for action in ["read", "delete", "write", "admin"] {
    if action in allowed { granted.push(action); }
}
println(granted);

// compound: in inside a condition and a ternary
let status = "warn";
println(status in ["warn", "error"] ? "alert" : "quiet");

// Integer arithmetic promotes to a float instead of wrapping, whether the
// operands sit on the stack or in a local (the fused store opcodes must agree).
let top = 9223372036854775807;
println(top + 1);
println(top - top - 1);
let big = 4611686018427387904;
println(big * 2);

fn bump(x) {
    x = x + 1;
    return x;
}
println(bump(9223372036854775807));

fn scale(x) {
    x = x * 2;
    return x;
}
println(scale(4611686018427387904));

fn concatParts(a, b) {
    let text = "";
    text = text + a;
    text = text + b;
    return text;
}
println(concatParts("a", "b"));

// `+` with a string on either side concatenates, including when the right
// operand is a constant the compiler folds into the opcode.
fn label(name) {
    let out = "n=";
    out = out + name;
    return out;
}
println(label("x"));
println(label("y") + "!");
let prefix = "pre";
println(prefix + "-fix");

// `%` truncates toward zero for floats too, so the sign follows the left
// operand exactly as it does for ints.
println(-1 % 2.5, 2.5 % -1, -7.5 % 2, 7.5 % -2);
println(str(-0.0 % 1), str(0.0 % -1));

// Bitwise operators take an integral float, and reject a fractional one by
// naming the operand the interpreter names.
println(1 & 2.0, 1 << 2.0, -8 >> 1.0, 5 ^ 1.0);
fn bitFailure(left, right) {
    try {
        return str(left & right);
    } catch (e) {
        return str(e);
    }
}
println(bitFailure(1, 2.5));
println(bitFailure("a", 2.5));
println(bitFailure(1.5, "a"));

// Lists compare element by element, then by length.
println([1, 2] < [1, 3], [1, 2] < [1, 2], [1, 2] < [1, 2, 0], [2] > [1, 9, 9]);

// The assignment operators that test their target first. The value is only
// evaluated when the test says it is wanted - which is the whole point of
// `m[k] ??= expensive()`, and the difference a load-operator-store version
// would not show.
let calls = 0;
fn valued() { calls = calls + 1; return 99; }

let missing = nil;
println(missing ??= valued(), calls);
println(missing ??= valued(), calls);

let zero = 0;               // 0 is truthy here, so ||= leaves it alone
println(zero ||= 5, zero);
let filled = nil;
println(filled ||= 5, filled);

let yes = 1;
println(yes &&= 7, yes);
let no = false;
println(no &&= 7, no);

// A target whose subexpressions have side effects runs them once, wanted or not.
let lookups = 0;
fn key() { lookups = lookups + 1; return "k"; }
let table = {"k": nil};
println(table[key()] ??= "first", lookups);
println(table[key()] ??= "second", lookups);

// The same through a field, a local in a function and a captured variable.
let box = {"inner": {"v": nil}};
println(box.inner.v ??= "deep", box.inner.v);
fn scope() {
    let local = nil;
    let out = fn() { local ??= "closed"; return local; };
    out();
    return local;
}
println(scope());

// As a statement the value is dropped, and the assignment still happens.
let statement = nil;
statement ??= "kept";
println(statement);
