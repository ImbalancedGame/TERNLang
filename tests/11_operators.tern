// Membership, slicing, and formatting.
println(2 in [1, 2, 3]);
println(9 in [1, 2, 3]);
println("ell" in "hello");
println("z" in "hello");
println("k" in {"k": 1});
println(3 in 0..<5);
println(3 not in 0..<3);

let xs = [10, 20, 30, 40, 50];
println(xs[1..3]);
println(xs[1..<3]);
println(xs[..2]);
println(xs[2..]);
println(xs[..]);
println(xs[-2..]);

let s = "abcdef";
println(s[1..3]);
println(s[..<2]);
println(s[3..]);

println(text.format("{0}-{}", "a", "b"));
println(text.format("{} and {}", "x", "y"));

// for loops over membership-heavy data
let allowed = ["read", "write"];
let granted = [];
for action in ["read", "delete", "write", "admin"] {
    if action in allowed { granted.push(action); }
}
println(granted);

// compound: in inside a condition and a ternary
let status = "warn";
println(status in ["warn", "error"] ? "alert" : "quiet");

// Integer arithmetic promotes to a float instead of wrapping, whether the
// operands sit on the stack or in a local (the fused store opcodes must agree).
let top = 9223372036854775807;
println(top + 1);
println(top - top - 1);
let big = 4611686018427387904;
println(big * 2);

fn bump(x) {
    x = x + 1;
    return x;
}
println(bump(9223372036854775807));

fn scale(x) {
    x = x * 2;
    return x;
}
println(scale(4611686018427387904));

fn concatParts(a, b) {
    let text = "";
    text = text + a;
    text = text + b;
    return text;
}
println(concatParts("a", "b"));

// `+` with a string on either side concatenates, including when the right
// operand is a constant the compiler folds into the opcode.
fn label(name) {
    let out = "n=";
    out = out + name;
    return out;
}
println(label("x"));
println(label("y") + "!");
let prefix = "pre";
println(prefix + "-fix");
