let n = 0;
while n < 3 {
    println("while " + n);
    n = n + 1;
}

for (let i = 0; i < 3; i++) {
    if (i == 1) { continue; }
    println("cfor " + i);
}

for i in 0..3 { println("range " + i); }
for i in 0..<3 { println("excl " + i); }
for item in ["a", "b"] { println("item " + item); }

let total = 0;
loop {
    total += 1;
    if (total >= 3) { break; }
}
println("loop total " + total);

let i = 0;
do {
    i++;
} while (i < 2);
println("do " + i);

if n == 3 { println("if"); } else if n == 4 { println("elseif"); } else { println("else"); }
let label = if n > 2 { "big" } else { "small" };
println(label);
let nested = if true { if false { 1 } else { 2 } } else { 3 };
println(nested);
println(if n == 0 { "zero" } else { "nonzero" });

// `!=` has to mean "not equal", including inside a condition and including for
// values that are not integers. The compiled backend once branched as though a
// non-integer `!=` were `==`; numbers took an integer fast path, so only a
// string in a condition showed it.
fn same_text(a, b) {
    if (a != b) { return "different"; }
    return "same";
}
fn equal_text(a, b) {
    if (a == b) { return "equal"; }
    return "unequal";
}
println(same_text("hel" + "lo", "hello"));
println(same_text("help", "hello"));
println(equal_text("hel" + "lo", "hello"));
println(equal_text("help", "hello"));

// --- truthiness --------------------------------------------------------------
// Only false and nil are falsy. 0, 0.0, "" and the empty collections are
// truthy, which is not the Python rule and is the one thing a reader arriving
// from Python will assume the other way round, so it is pinned here rather
// than only described in docs/language.md.
fn truthy(value) {
    if (value) { return "truthy"; }
    return "falsy";
}
println("int 0:", truthy(0));
println("float 0:", truthy(0.0));
println("empty text:", truthy(""));
println("empty list:", truthy([]));
println("empty map:", truthy({}));
println("nil:", truthy(nil));
println("false:", truthy(false));
println("true:", truthy(true));
println("one:", truthy(1));
// The same rule reached through `bool`, which has to agree with `if`.
println("bool(0):", bool(0), "bool(\"\"):", bool(""), "bool([]):", bool([]));
