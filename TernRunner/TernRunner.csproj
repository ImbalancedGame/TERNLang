<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TERN.Runner</AssemblyName>
    <RootNamespace>TernRunner</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Into build/ with the name the launcher and the IDE expect, the same
         layout tools/build.py produces, so `dotnet build` and the sandbox
         bootstrap give an interchangeable result. `tools/tern` and the IDE both
         run `dotnet build/TERN.Runner.dll`. -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\build\</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TERN\TERN.csproj" />
  </ItemGroup>

</Project>
