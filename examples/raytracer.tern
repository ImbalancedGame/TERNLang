// A ray tracer, written in TERN, and the PNG file it writes.
//
//   tern run examples/raytracer.tern                     # raytrace.png, 320x240
//   tern run examples/raytracer.tern --size 640x480      # slower, sharper
//   tern run examples/raytracer.tern --samples 3         # 3x3 samples per pixel
//   tern run examples/raytracer.tern --ascii             # preview in the terminal
//   tern run examples/raytracer.tern --out shot.png
//
// There is no image library here and no GPU: the scene is intersected ray by
// ray on the CPU, the pixels are shaded as floats, and the file is assembled
// byte by byte - PNG signature, IHDR, a zlib stream of stored deflate blocks,
// IEND, with CRC32 over every chunk. `fs.writeBytes` puts it on disk, which is
// the half of the file API that does not go through a string: a TERN string
// holds characters, and a PNG's first byte (0x89) is not one.
//
// It is also the only example that does real arithmetic - a 320x240 frame is
// 76,800 primary rays, each tested against four spheres and a plane, with a
// shadow ray and a reflection - so it is the program to run when you want to
// know what the interpreter costs. `--samples` is the knob: 2 means four rays
// per pixel and four times the work.
//
// The scene is fixed and deterministic: same input, same pixels, same file, in
// the interpreter and in a compiled binary. tools/test_examples.py runs both
// and compares the bytes.

import "std:fs";
import "std:math";
import "std:os";
import "std:time";

// --- the scene ---------------------------------------------------------------
//
// A sphere is {x, y, z, radius, r, g, b, mirror}: the colour is 0..1 and
// `mirror` is how much of the reflection is used, so 0 is a matte ball and 1 a
// mirror. A list of eight numbers rather than a struct because the inner loop
// reads them four million times and an index into a list is cheaper than a
// field lookup - the one place in these examples where that matters, and worth
// the ugliness because it is what keeps a frame under a second.

fn make_scene() {
    return [
        // x      y      z     radius   r     g     b    mirror
        [-1.10,  0.55,  0.10,  0.55,  0.90, 0.25, 0.20, 0.35],
        [ 0.00,  0.45, -0.55,  0.45,  0.20, 0.55, 0.95, 0.10],
        [ 1.15,  0.70,  0.05,  0.70,  0.95, 0.80, 0.25, 0.55],
        [ 0.10,  0.30,  1.15,  0.30,  0.75, 0.75, 0.80, 0.05],
    ];
}

// Where the light is, and what colour the sky is at the top and the horizon.
fn light_position() { return [-3.0, 4.0, 2.5]; }
fn sky_top() { return [0.08, 0.10, 0.20]; }
fn sky_horizon() { return [0.55, 0.62, 0.75]; }

// --- geometry ----------------------------------------------------------------
//
// The intersection routines are plain arithmetic on floats, for the reason
// above. `hit_...` returns the distance along the ray, or -1 when it misses;
// a ray that starts inside a sphere hits it at the near root, which is why the
// smaller root is chosen rather than the first positive one.

/// Distance to the sphere at (cx, cy, cz), or -1.
fn hit_sphere(ox, oy, oz, dx, dy, dz, cx, cy, cz, radius) {
    let lx = ox - cx;
    let ly = oy - cy;
    let lz = oz - cz;
    let b = lx * dx + ly * dy + lz * dz;
    let c = lx * lx + ly * ly + lz * lz - radius * radius;
    let disc = b * b - c;
    if (disc < 0) { return -1; }
    let root = math.sqrt(disc);
    let near = -b - root;
    if (near > 0.0001) { return near; }
    let far = -b + root;
    if (far > 0.0001) { return far; }
    return -1;
}

/// Distance to the floor plane at y = 0, or -1. The checkerboard is decided at
/// shading time from the hit point, not here, so the plane costs one division.
fn hit_floor(oy, dy) {
    if (dy > -0.00001) { return -1; }
    let distance = -oy / dy;
    if (distance > 0.0001) { return distance; }
    return -1;
}

/// The nearest sphere, as [distance, index], or [-1, -1].
fn nearest_sphere(ox, oy, oz, dx, dy, dz, scene) {
    let best = -1.0;
    let which = -1;
    for i in range(0, len(scene)) {
        let s = scene[i];
        let distance = hit_sphere(ox, oy, oz, dx, dy, dz, s[0], s[1], s[2], s[3]);
        if (distance > 0 && (best < 0 || distance < best)) {
            best = distance;
            which = i;
        }
    }
    return [best, which];
}

// --- shading -----------------------------------------------------------------
//
// The tracer returns its colour in three globals rather than a list, because a
// list per ray is 76,800 allocations per frame for numbers that live for one
// line. This is the other measured choice in the file.

let trace_r = 0.0;
let trace_g = 0.0;
let trace_b = 0.0;

fn shade(ox, oy, oz, dx, dy, dz, depth, scene) {
    let nearest = nearest_sphere(ox, oy, oz, dx, dy, dz, scene);
    let distance = nearest[0];
    let index = nearest[1];
    let floor_distance = hit_floor(oy, dy);
    let is_floor = false;
    if (floor_distance > 0 && (distance < 0 || floor_distance < distance)) {
        distance = floor_distance;
        is_floor = true;
    }

    if (distance < 0) {
        // The sky: a vertical gradient, so an unbounded ray still has a
        // direction rather than a colour picked out of the air.
        let up = math.clamp((dy + 0.35) / 1.35, 0.0, 1.0);
        let top = sky_top();
        let horizon = sky_horizon();
        trace_r = horizon[0] + (top[0] - horizon[0]) * up;
        trace_g = horizon[1] + (top[1] - horizon[1]) * up;
        trace_b = horizon[2] + (top[2] - horizon[2]) * up;
        return;
    }

    let hx = ox + dx * distance;
    let hy = oy + dy * distance;
    let hz = oz + dz * distance;

    let surface_r = 0.0;
    let surface_g = 0.0;
    let surface_b = 0.0;
    let mirror = 0.0;
    let nx = 0.0;
    let ny = 1.0;
    let nz = 0.0;

    if (is_floor) {
        // A checkerboard, two squares per unit, dark towards the horizon
        // because a floor that is lit evenly looks like a wall.
        let square = (math.floor(hx) + math.floor(hz)) % 2;
        let tone = 0.72;
        if (square != 0) { tone = 0.45; }
        let fade = 1.0 / (1.0 + distance * 0.06);
        surface_r = tone * 0.9 * fade + 0.03;
        surface_g = tone * 0.9 * fade + 0.03;
        surface_b = tone * 0.95 * fade + 0.04;
        mirror = 0.18 * fade;
    } else {
        let s = scene[index];
        surface_r = s[4];
        surface_g = s[5];
        surface_b = s[6];
        mirror = s[7];
        nx = (hx - s[0]) / s[3];
        ny = (hy - s[1]) / s[3];
        nz = (hz - s[2]) / s[3];
    }

    // Two-sided: a ray that hits the inside of a sphere should light the inside
    // rather than go black.
    if (dx * nx + dy * ny + dz * nz > 0) {
        nx = -nx;
        ny = -ny;
        nz = -nz;
    }

    let light = light_position();
    let to_x = light[0] - hx;
    let to_y = light[1] - hy;
    let to_z = light[2] - hz;
    let to_length = math.sqrt(to_x * to_x + to_y * to_y + to_z * to_z);
    let light_x = to_x / to_length;
    let light_y = to_y / to_length;
    let light_z = to_z / to_length;

    // A shadow ray: short of the light, so the light itself is not an occluder.
    let lit = 1.0;
    let blocker = nearest_sphere(hx + nx * 0.002, hy + ny * 0.002, hz + nz * 0.002,
                                 light_x, light_y, light_z, scene);
    if (blocker[0] > 0 && blocker[0] < to_length) {
        lit = 0.12;
    } else if (hit_floor(hy + ny * 0.002, light_y) > 0) {
        // The plane is infinite, so it casts shadows too - but only for a point
        // above it, and only if the light is below the horizon in that respect.
        if (hy + ny * 0.002 > 0 && light_y < 0) { lit = 0.12; }
    }

    let diffuse = nx * light_x + ny * light_y + nz * light_z;
    if (diffuse < 0) { diffuse = 0; }

    // Blinn-Phong, with the half vector between the light and the eye.
    let half_x = light_x - dx;
    let half_y = light_y - dy;
    let half_z = light_z - dz;
    let half_length = math.sqrt(half_x * half_x + half_y * half_y + half_z * half_z);
    let specular = nx * (half_x / half_length) + ny * (half_y / half_length) + nz * (half_z / half_length);
    if (specular < 0) {
        specular = 0;
    }
    specular = (specular ** 48) * 0.55 * lit;

    // Ambient: enough that a shadowed side is a dark version of the object
    // rather than a hole in the picture.
    let ambient = 0.16;
    trace_r = surface_r * (ambient + diffuse * lit) + specular;
    trace_g = surface_g * (ambient + diffuse * lit) + specular;
    trace_b = surface_b * (ambient + diffuse * lit) + specular;

    // One reflection, for as long as the depth allows. The reflected ray starts
    // slightly off the surface so it does not hit the surface it just left, and
    // the recursive call writes trace_*, so the lit colour is kept first.
    if (mirror > 0.01 && depth < 3) {
        let base_r = trace_r;
        let base_g = trace_g;
        let base_b = trace_b;
        let dot = dx * nx + dy * ny + dz * nz;
        let rx = dx - 2 * dot * nx;
        let ry = dy - 2 * dot * ny;
        let rz = dz - 2 * dot * nz;
        shade(hx + nx * 0.002, hy + ny * 0.002, hz + nz * 0.002, rx, ry, rz, depth + 1, scene);
        trace_r = base_r * (1 - mirror) + trace_r * mirror;
        trace_g = base_g * (1 - mirror) + trace_g * mirror;
        trace_b = base_b * (1 - mirror) + trace_b * mirror;
    }
}

/// A shaded float to a byte: clamped, because a specular highlight can exceed 1
/// and a negative ambient would go below 0, and neither is the encoder's job.
fn to_byte(value) {
    let scaled = int(value * 255.0 + 0.5);
    if (scaled < 0) { return 0; }
    if (scaled > 255) { return 255; }
    return scaled;
}

fn render(width, height, samples, scene) {
    let pixels = [];
    let aspect = width / height;
    // Looking down the +z axis from (0, 1.1, 4.2), which puts the horizon a
    // third of the way up the frame.
    let eye_x = 0.0;
    let eye_y = 1.15;
    let eye_z = 4.20;
    let target_y = 0.75;
    let field = 0.55;

    for y in range(0, height) {
        for x in range(0, width) {
            let r = 0.0;
            let g = 0.0;
            let b = 0.0;
            for sy in range(0, samples) {
                for sx in range(0, samples) {
                    // Pixel centre, offset inside the pixel for each sample.
                    let px = x + (sx + 0.5) / samples;
                    let py = y + (sy + 0.5) / samples;
                    let u = ((px / width) * 2.0 - 1.0) * aspect * field;
                    let v = (1.0 - (py / height) * 2.0) * field;
                    // z is negative because the camera sits in front of the
                    // scene at +z looking back at it, which is the convention
                    // the sphere positions above are written in.
                    //
                    // The direction is normalised first. The quadratic in
                    // hit_sphere solves for a unit direction; feeding it a
                    // vector of length 1.08 does not fail loudly, it returns a
                    // distance that is not the intersection, and every normal
                    // below is then off the surface by the same factor - which
                    // looks like a shading bug and is not one.
                    let dir_y = v + target_y - eye_y;
                    let length = math.sqrt(u * u + dir_y * dir_y + 1.0);
                    shade(eye_x, eye_y, eye_z, u / length, dir_y / length, -1.0 / length, 0, scene);
                    r = r + trace_r;
                    g = g + trace_g;
                    b = b + trace_b;
                }
            }
            let count = samples * samples;
            pixels.push(to_byte(r / count));
            pixels.push(to_byte(g / count));
            pixels.push(to_byte(b / count));
        }
    }
    return pixels;
}

// --- PNG ---------------------------------------------------------------------
//
// A PNG is a signature and a sequence of chunks, each one a length, a four-byte
// type, the data and a CRC32 of the type and data. The image data is a zlib
// stream, and zlib allows deflate blocks that store the bytes instead of
// compressing them - so this writer needs no compressor, just the framing. The
// files are larger than a real encoder would make them and every viewer reads
// them, which is the right trade for an example whose point is the ray tracer.

fn crc_table() {
    let table = [];
    for n in range(0, 256) {
        let c = n;
        for k in range(0, 8) {
            // `!= 0` rather than the value itself: in TERN only false and nil
            // are falsy, so a bare `if (c & 1)` would always be taken.
            if ((c & 1) != 0) {
                c = 0xEDB88320 ^ (c >> 1);
            } else {
                c = c >> 1;
            }
        }
        table.push(c);
    }
    return table;
}

fn crc32(bytes, table) {
    // The register starts at all ones and is inverted at the end, which is the
    // detail that makes a CRC read as 0xFFFFFFFF for a wrong one.
    let crc = 0xFFFFFFFF;
    for byte in bytes {
        crc = table[(crc ^ byte) & 0xFF] ^ (crc >> 8);
    }
    return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

fn adler32(bytes) {
    let a = 1;
    let b = 0;
    for byte in bytes {
        a = a + byte;
        if (a >= 65521) { a = a - 65521; }
        b = b + a;
        if (b >= 65521) { b = b - 65521; }
    }
    return (b << 16) | a;
}

fn push_u32(out, value) {
    out.push((value >> 24) & 0xFF);
    out.push((value >> 16) & 0xFF);
    out.push((value >> 8) & 0xFF);
    out.push(value & 0xFF);
}

fn png_chunk(out, kind, data, table) {
    let body = text.toBytes(kind) + data;
    push_u32(out, len(data));
    for byte in body { out.push(byte); }
    push_u32(out, crc32(body, table));
}

fn zlib_store(raw) {
    // 0x78 0x01: deflate, 32 KiB window, fastest. The two bytes are checked by
    // (0x78 << 8 | 0x01) % 31 == 0, which is the header's own integrity test.
    let out = [0x78, 0x01];
    let offset = 0;
    while (offset < len(raw)) {
        let length = min(65535, len(raw) - offset);
        let final = offset + length >= len(raw) ? 1 : 0;
        out.push(final);
        out.push(length & 0xFF);
        out.push((length >> 8) & 0xFF);
        // One's complement of the length, over sixteen bits.
        out.push(65535 - length & 0xFF);
        out.push((65535 - length) >> 8);
        for i in range(offset, offset + length) {
            out.push(raw[i]);
        }
        offset = offset + length;
    }
    push_u32(out, adler32(raw));
    return out;
}

fn png_encode(width, height, pixels) {
    let table = crc_table();
    let out = [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A];

    let header = [];
    push_u32(header, width);
    push_u32(header, height);
    header.push(8);   // bits per channel
    header.push(2);   // colour type 2: truecolour, RGB
    header.push(0);   // compression: deflate
    header.push(0);   // filter: adaptive
    header.push(0);   // interlace: none
    png_chunk(out, "IHDR", header, table);

    // Each scanline carries a filter byte, and 0 is "none": the filter that
    // still looks like the picture, which matters when the file is not
    // compressed.
    let raw = [];
    for y in range(0, height) {
        raw.push(0);
        for i in range(0, width * 3) {
            raw.push(pixels[y * width * 3 + i]);
        }
    }
    png_chunk(out, "IDAT", zlib_store(raw), table);
    png_chunk(out, "IEND", [], table);
    return out;
}

// --- output ------------------------------------------------------------------

const RAMP = " .:-=+*#%@";

fn ascii_preview(width, height, pixels, columns) {
    let rows = max(1, int(columns * height / width / 2));
    for row in range(0, rows) {
        let line = "";
        for column in range(0, columns) {
            let x = int(column * width / columns);
            let y = int(row * height / rows);
            let at = (y * width + x) * 3;
            // Rec. 601 luma, which is what "brightness" means closely enough
            // for characters.
            let luma = (pixels[at] * 0.299 + pixels[at + 1] * 0.587 + pixels[at + 2] * 0.114) / 255.0;
            let index = int(luma * (len(RAMP) - 1));
            line = line + RAMP[index];
        }
        println(line);
    }
}

fn usage() {
    println("a CPU ray tracer that writes a PNG with no image library");
    println("  --out PATH        where to write it (default raytrace.png)");
    println("  --size WIDTHxHEIGHT  image size (default 320x240)");
    println("  --samples N       N x N rays per pixel, 1..4 (default 1)");
    println("  --ascii           also print a preview in the terminal");
    println("  --help            this text");
}

fn main() {
    let arguments = os.args();
    let out = "raytrace.png";
    let width = 320;
    let height = 240;
    let samples = 1;
    let show_ascii = false;

    let index = 0;
    while (index < len(arguments)) {
        let argument = arguments[index];
        if (argument == "--out" && index + 1 < len(arguments)) {
            index += 1;
            out = arguments[index];
        } else if (argument == "--size" && index + 1 < len(arguments)) {
            index += 1;
            let parts = arguments[index].split("x");
            if (len(parts) != 2) {
                println("--size wants WIDTHxHEIGHT, not " + arguments[index]);
                return;
            }
            width = int(parts[0]);
            height = int(parts[1]);
        } else if (argument == "--samples" && index + 1 < len(arguments)) {
            index += 1;
            samples = int(arguments[index]);
        } else if (argument == "--ascii") {
            show_ascii = true;
        } else if (argument == "--help" || argument == "-h") {
            usage();
            return;
        } else {
            println("unknown option: " + argument);
            usage();
            return;
        }
        index += 1;
    }

    if (width < 1 || height < 1 || width > 4096 || height > 4096) {
        println("--size must be between 1x1 and 4096x4096");
        return;
    }
    if (samples < 1 || samples > 4) {
        println("--samples must be between 1 and 4");
        return;
    }

    let scene = make_scene();
    println("ray tracing " + str(width) + "x" + str(height) +
            " at " + str(samples) + "x" + str(samples) + " samples...");
    let started = time.millis();
    let pixels = render(width, height, samples, scene);
    let traced = time.millis() - started;

    started = time.millis();
    let file = png_encode(width, height, pixels);
    fs.writeBytes(out, file);
    let encoded = time.millis() - started;

    let rays = width * height * samples * samples;
    println("traced " + str(rays) + " rays in " + str(traced) + " ms");
    println("wrote " + out + ": " + str(len(file)) + " bytes in " + str(encoded) + " ms");
    if (traced > 0) {
        println("that is " + str(int(rays / traced)) + " rays per millisecond");
    }
    if (show_ascii) {
        ascii_preview(width, height, pixels, 72);
    }
}

main();
