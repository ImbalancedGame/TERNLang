<Project Sdk="Microsoft.NET.Sdk">

  <!-- The syntax server: an LSP 3.17 server over stdio. Built with the .NET SDK
       (`dotnet build ide/Server/TERN.Ide.csproj`); the sandbox's Roslyn
       bootstrap in tools/build.py compiles the same sources into the same
       assembly name, so the IDE finds it either way. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TERN.Ide</AssemblyName>
    <RootNamespace>TERN.Ide</RootNamespace>
    <!-- Same flat layout as the bootstrap build, so runtime.py finds it in one
         place on every platform. -->
    <!-- Flat into build\, with no configuration or framework folder: the same
         layout tools/build.py writes, so `dotnet build` and the sandbox
         bootstrap give an interchangeable result and every launcher finds the
         assembly by the one path it knows. Debug and Release overwrite each
         other, which is what the bootstrap does too. -->
    <OutputPath>$(MSBuildThisFileDirectory)..\..\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TERN\TERN.csproj" />
  </ItemGroup>

</Project>
