<Project Sdk="Microsoft.NET.Sdk">

  <!-- The debugger: drives the VM over its own line protocol so a program can be
       stopped mid-instruction. See ide/Server/TERN.Ide.csproj for the layout. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TERN.Debug</AssemblyName>
    <RootNamespace>TERN.Debug</RootNamespace>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\build\</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TERN\TERN.csproj" />
  </ItemGroup>

</Project>
