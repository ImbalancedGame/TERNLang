<Project Sdk="Microsoft.NET.Sdk">

  <!-- The debugger: drives the VM over its own line protocol so a program can be
       stopped mid-instruction. See ide/Server/TERN.Ide.csproj for the layout. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TERN.Debug</AssemblyName>
    <RootNamespace>TERN.Debug</RootNamespace>
    <!-- Flat into build\, with no configuration or framework folder: the same
         layout tools/build.py writes, so `dotnet build` and the sandbox
         bootstrap give an interchangeable result and every launcher finds the
         assembly by the one path it knows. Debug and Release overwrite each
         other, which is what the bootstrap does too. -->
    <OutputPath>$(MSBuildThisFileDirectory)..\..\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TERN\TERN.csproj" />
  </ItemGroup>

</Project>
